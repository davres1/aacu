   l_cnt                 number;
   l_errm                varchar2(4000);
   l_process_status      varchar2(10);
   --l_prog_short_name,l_parameters,l_repeat_interval,l_repeat_unit,l_start_time,l_end_date,l_options,
   l_email_addr          varchar2(4000);       
        
   cursor c_prc_sched_cp is 
   
      select rowid row_id,
             conc_program_name,
             conc_program_short_name,
             conc_program_id,
             parameter_string,
             repeat_interval,
             repeat_unit,
             start_time,
             end_date,
             options,
             send_email_to
        from VMMC_SCHEDULED_CP_LIST;

begin
   if upper(vmmc_commons_pk.get_curr_instance) = 'EPROD'
   then
      l_email_subject := 'R12.2.9 Alert Message : Attempt to Run Auto Schedule Concurrent Programs in '||vmmc_commons_pk.get_curr_instance;
      l_email_message := 'NOTE : The Auto Schedule Concurrent Program MUST NOT Run in '||vmmc_commons_pk.get_curr_instance||', exiting program...'||chr(10)||chr(10)||
                         'Please contact ERP System Admin, if you need to do so...';
      vmmc_commons_pk.send_email('',                                       -- p_program_name
                                 'vmerp@virginiamason.org',                -- p_from_address
                                 'Anjan.Chakraborty@Virginiamason.org,Ashwani.Miglani@Virginiamason.org,Sumit.Davre@CommonSpirit.org',                        -- p_to_address
                                 NULL,                                     -- p_cc_address
                                 l_email_subject, -- p_subject
                                 l_email_message -- p_message
                                );
      return;
   else
      l_email_subject := 'R12.2.9 Alert Message : Now Running Auto Schedule Concurrent Programs in '||vmmc_commons_pk.get_curr_instance;
      l_email_message := 'NOTE : The Auto Schedule Concurrent Program will now start in '||vmmc_commons_pk.get_curr_instance||chr(10)||chr(10)||
                         'Please contact ERP System Admin, if you have any concern regarding this...';
      vmmc_commons_pk.send_email('',                                       -- p_program_name
                                 'vmerp@virginiamason.org',                -- p_from_address
                                 'Anjan.Chakraborty@Virginiamason.org,Ashwani.Miglani@Virginiamason.org,Sumit.Davre@CommonSpirit.org',                        -- p_to_address
                                 NULL,                                     -- p_cc_address
                                 l_email_subject, -- p_subject
                                 l_email_message -- p_message
                                );
   end if;
   update VMMC_SCHEDULED_CP_LIST
      set error_message      = NULL,
          lastrun_trace_info = NULL,
          process_status     = NULL;
   commit;       
   -----------------------------------------------------------------------------
   -- Cancel Scheduled Concurrent Program
   -----------------------------------------------------------------------------
   for c_prc_sched_cp_rec in c_prc_sched_cp
   loop
      begin
         l_errm := NULL;
         select count(*)
           into l_cnt
           from fnd_concurrent_requests x
          WHERE x.status_code IN ('Q','I') 
            and x.requested_start_date > sysdate  
            and x.hold_flag = 'N' 
            and x.concurrent_program_id = c_prc_sched_cp_rec.conc_program_id;
         if l_cnt > 0
         then  
            UPDATE fnd_concurrent_requests x
               SET x.phase_code = 'C', 
                   x.status_code = 'X' 
             WHERE x.status_code IN ('Q','I') 
               and x.requested_start_date > sysdate  
               and x.hold_flag = 'N' 
               and x.concurrent_program_id = c_prc_sched_cp_rec.conc_program_id;
            commit;
            l_trace_info     := 'Cancelled Scheduled Concurrent Program';
            l_errm           := 'Success Cancelled...';
            l_process_status := 'S1';
         else
            l_trace_info     := 'Scheduled Concurrent Program not Found';
            l_errm           := 'Scheduled Concurrent Program not Found';
            l_process_status := 'S0';
         end if;    
      exception
      when others
      then
         l_trace_info     := 'ERROR Cancelling Scheduled Concurrent Program : '||SQLERRM;
         l_errm           := SQLERRM; 
         l_process_status := 'E1';
      end;
      update VMMC_SCHEDULED_CP_LIST
         set error_message      = l_errm,
             lastrun_trace_info = l_trace_info,
             process_status     = l_process_status,
             last_run_date      = sysdate
       where rowid = c_prc_sched_cp_rec.row_id;
      commit;      
   end loop;
   -----------------------------------------------------------------------------
   -- Scheduled Concurrent Program
   -----------------------------------------------------------------------------
   for c_prc_sched_cp_rec in c_prc_sched_cp
   loop
      begin
         --l_prog_short_name,l_parameters,l_repeat_interval,l_repeat_unit,l_start_time,l_end_date,l_options,l_email_addr 
         --vmmc_commons_pk.VMMC_SCHED_CONC_PROGRAM(l_prog_short_name,l_parameters,l_repeat_interval,l_repeat_unit,l_start_time,l_end_date,l_options,l_email_addr);
         l_email_addr := c_prc_sched_cp_rec.send_email_to;
         vmmc_commons_pk.VMMC_SCHED_CONC_PROGRAM(c_prc_sched_cp_rec.conc_program_short_name,c_prc_sched_cp_rec.parameter_string,c_prc_sched_cp_rec.repeat_interval,c_prc_sched_cp_rec.repeat_unit,c_prc_sched_cp_rec.start_time,c_prc_sched_cp_rec.end_date,c_prc_sched_cp_rec.options,l_email_addr);
         l_trace_info     := 'Scheduled Concurrent Program Successfully...';
         l_errm           := 'Return Message : '||l_email_addr;
         l_process_status := 'S2';
      exception
      when others
      then
         l_trace_info     := 'ERROR Scheduling Concurrent Program : '||SQLERRM;
         l_errm           := SQLERRM; 
         l_process_status := 'E2';
      end;
      update VMMC_SCHEDULED_CP_LIST
         set error_message      = error_message||chr(10)||l_errm,
             lastrun_trace_info = lastrun_trace_info||chr(10)||l_trace_info,
             process_status     = decode(process_status,NULL,l_process_status,process_status||', '||l_process_status),
             last_run_date      = sysdate
       where rowid = c_prc_sched_cp_rec.row_id;
      commit;      
   end loop;
end;
/


------------- End of Update Definitions ----------------
