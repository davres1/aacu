update VMMC_SCHEDULED_CP_LIST x
   set (x.CONC_PROGRAM_ID,x.CONC_PROGRAM_NAME)
     = (select fcp.concurrent_program_id,fcpt.user_concurrent_program_name 
          from fnd_concurrent_programs fcp,fnd_concurrent_programs_tl fcpt
         where fcpt.concurrent_program_id = fcp.concurrent_program_id
           and fcp.concurrent_program_name = x.CONC_PROGRAM_SHORT_NAME);
commit;
