                                         , x_value                      => v_value
                                         , x_level_name                 => 'SERVRESP'               
                                         , x_level_value                => -1  
                                         ,x_level_value_app_id          =>  -1
                                         , x_level_value2               => v_node_id      
                              ) ; 
