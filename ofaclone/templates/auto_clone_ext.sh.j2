   v_check            boolean;
   v_profile_name varchar2(240) := 'Applications Web Agent';
   v_profile           varchar2(240);
   v_value             varchar2(2000)   := 'https://vm{{ tgt_app_external_node }}.virginiamason.org:443/pls/etest'; -- 3 means external, 2 means normal
   v_node_name    varchar2(240)   := '{{ tgt_app_external_node }}';
