  --
  -- create an equivalent to kbdx_apps_initialize.sql based on presents of kbace.kbdx_users table
  --
delete from kbace.kbdx_test where val1 = 'kbdx_reset_all'; 
commit;
  --
Declare
 lb_lobcache           boolean        := false;
 ln_count              number;
 ln_isCustomSecurity   number         := to_number(&&isCustomSecurity);
 ln_isxxkbx            number                                     := 0;
 ln_lobcache_found     number;
 lv_end_message        varchar2(500);
 lv_exec               varchar2(200);
 lv_parallel           varchar2(3)    := '&&PARALLEL';
BEGIN
  lv_end_message := 'select ''END KBDX_RESET_ALL on &&DATABASENAME ''||TO_CHAR(SYSDATE, ''DD-MON-YYYY HH24:MI:SS'')||'' SESSION_USER &&apps_account'' from dual;';
  select count(*) into ln_lobcache_found from all_directories where directory_name = 'LOBCACHE';
  If ln_lobcache_found = 0 then
    delete from xkb_action_parameters where parameter_name in ('RAC_CACHE','LOBCACHE');
    insert into xkb_action_parameters (parameter_name, parameter_value) values ('RAC_CACHE', 'OFF');
    commit;
  End if;
  If lv_parallel = 'YES' AND ln_lobcache_found > 0 then
    lb_lobcache := true;
  Else
    lb_lobcache := false;
  End if;
  select count(*) into ln_count from dba_objects where object_name = 'KBDX_USERS' and object_type = 'TABLE' and owner = 'KBACE';
  If ln_count = 1 THEN --kbdx_user table is available then do work
    If ln_isxxkbx > 0 THEN
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','Accept xxkbx_password prompt ''Enter value for XXKBX_PASSWORD [PW]: '' hide');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt ');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt Verifing Password by Connecting as XXKBX');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','conn XXKBX'||'/&&'||'xxkbx_password@&&'||'ORACLE_SID');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt ');end;
      If &&have_opw = 0 THEN
        begin kbdx_kube_utilities.insert_test('kbdx_reset_all','Accept apps_password prompt ''Reconnecting... Enter apps_password [pw]: '' hide');end;
      Else
        begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt Verified... Reconnecting to &&apps_account');end;
      End If;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','conn &&apps_account'||'/&&'||'apps_password@&&'||'ORACLE_SID');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt ');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','delete from kbace.kbdx_users where user_id = -900;');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','execute kbdx_security_pkg.apps(''&&'||'xxkbx_password'',''&&'||'xxkbx_password'');');end;
    Else
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','Accept apps_password prompt ''Enter value for APPS_PASSWORD [PW]: '' hide');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt ');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt Verifing Password by Connecting as &&'||'apps_account');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','conn &&apps_account'||'/&&'||'apps_password@&&'||'ORACLE_SID');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt ');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','delete from kbace.kbdx_users where user_id = -900;');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','execute kbdx_security_pkg.apps(''&&'||'apps_password'',''&&'||'apps_password'');');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','commit;');end;
    End If;
  End If;
  If ln_isCustomSecurity = 1 THEN
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','Active SSO_LOCAL_BOTH_LOGIN found in xkb_action_parameters.');end;
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt ...SINGLE-SIGN-ON detected. Login method is currently &&'||'sso_local_both_login....');end;
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt ');end;
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all','Accept login_method prompt ''Select login method using S=SSO, L=LOCAL, B=BOTH? S/L/B: ''');end;
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all','select ''Login method is now ''||decode(upper(''&&'||'login_method''),''S'',''SSO'',''L'',''LOCAL'',''B'',''BOTH'',''&&'||'sso_local_both_login'')||''.'' from dual;');end;
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all','delete from xkb_action_parameters where parameter_name = ''SSO_LOCAL_BOTH_LOGIN'';');end;
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all','insert into xkb_action_parameters (PARAMETER_NAME , PARAMETER_VALUE) values (''SSO_LOCAL_BOTH_LOGIN'',decode(upper(''&&'||'login_method''),''S'',''SSO'',''L'',''LOCAL'',''B'',''BOTH'',''LOCAL''));');end;
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all','commit;');end;
  Else
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','Active SSO_LOCAL_BOTH_LOGIN not found in xkb_action_parameters.');end;
  End If;
  If lb_lobcache then
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all','@kbdx_reset_lobcache.sql;');end;
  End if;
  begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt ');end;
END;
