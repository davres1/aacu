  --
  -- *** Security Grants ***
  --
Declare
 lb_valid_publicacct   boolean        := true;
 ln_isxxkbx            number                                     := 0;
 lv_exec               varchar2(600);
   --
 CURSOR C_REVOKE is
  select 'REVOKE '||p.privilege||' ON '||p.table_name||' FROM '||p.grantee beRevoked
    from DBA_TAB_PRIVS p
   where p.grantor = '&&apps_account'
     and p.table_name = 'KBDX_SECURITY_PKG'
     and p.privilege = 'EXECUTE'
     and p.grantee <> 'XXKBX'; --revoke from applsyspub
   --
 CURSOR C_DROP is
 select 'DROP SYNONYM '||o.owner||'.KBDX_SECURITY_PKG' beDropped
   from dba_objects o
  where o.object_type = 'SYNONYM'
    and o.object_name = 'KBDX_SECURITY_PKG'
    and o.owner <> 'XXKBX'; --drop from applsyspub
   --
Begin
  For i in C_REVOKE LOOP
    Begin
      lv_exec := i.beRevoked;
      execute immediate lv_exec;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',i.beRevoked);end;
     EXCEPTION
       WHEN OTHERS THEN
         dbms_output.put_line(' ***FAILED*** REVOKE EXECUTE FAILED ***FAILED***'); 
         dbms_output.put_line(' '||i.beRevoked); --cannot happen
         begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','***FAILED: '||i.beRevoked);end;
    End;
  End Loop;
  For i in C_DROP LOOP
    Begin
      lv_exec := i.beDropped;
      execute immediate lv_exec;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',i.beDropped);end;
     EXCEPTION
       WHEN OTHERS THEN
         dbms_output.put_line(' ***FAILED*** DROP SYNONYM FAILED ***FAILED***'); 
         dbms_output.put_line(' '||i.beDropped); --cannot happen
         begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','***FAILED: '||i.beDropped);end;
    End;
  End Loop;
  If ln_isxxkbx <> 2 THEN
    Begin
      lv_exec := 'GRANT EXECUTE on KBDX_SECURITY_PKG to '||upper('applsyspub');
      execute immediate lv_exec;
      lb_valid_publicacct := true;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_exec);end;
     EXCEPTION
       WHEN OTHERS THEN
         lb_valid_publicacct := false;
         delete from xkb_action_parameters where parameter_name in ('INSTANCE_NAME');
         insert into xkb_action_parameters (parameter_name, parameter_value) values ('INSTANCE_NAME', '***EXECUTE $&&BASEPATH/utilities/kbdx_reset_all.sql as the APPS USER.***');
         commit;
         dbms_output.put_line(' ***FAILED*** applsyspub is an INVALID DATABACE ACCOUNT NAME ***FAILED***');
         begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','FAILED: applsyspub is an INVALID DATABACE ACCOUNT NAME');end;
         dbms_output.put_line(' ');
    End;
    If lb_valid_publicacct THEN
      Begin
        lv_exec := 'CREATE SYNONYM applsyspub'||'.KBDX_SECURITY_PKG for &&apps_account'||'.KBDX_SECURITY_PKG';
        execute immediate lv_exec;
        begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_exec);end;
       EXCEPTION
         WHEN OTHERS THEN
           begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','FAILED: '||lv_exec);end;
           NULL;
      End;
    End If; -- lb_valid_publicacct
  End If;
End;
