Declare
 ln_count              number; 
 ln_isxxkbx            number                                     := 0;
Begin
  delete from xkb_action_parameters where parameter_name = 'KBDX_USERS';
  select count(*) into ln_count from dba_objects where object_name = 'KBDX_USERS' and object_type = 'TABLE' and owner = 'KBACE';
  If ln_count = 0  THEN
