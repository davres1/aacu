prompt
set termout on
Declare
   /* much the same test in kbace_diagnostic.sql */
 l_utl_file_type       UTL_FILE.file_type;
 ln_missing            number          := 0;
 lv_file_name          varchar2(32)    := 'TEST.FILE';
 lv_message            varchar2(1000);
 lv_parallel           varchar2(3)     := '&&PARALLEL';
 lv_parameter_value    xkb_action_parameters.parameter_value%type;
   --
 CURSOR c_fail IS
 select val2 from kbace.kbdx_test where val1 = 'kbdx_reset_all_summary' and val2 like 'FAIL%' order by val0;
   --
Begin
   dbms_output.put_line('');
   dbms_output.put_line('...Testing LOBMANIP...');
   dbms_output.put_line('');
   ln_missing := -1;
   ln_missing := kbdx_file_utils.open_file('LOBMANIP', lv_file_name, 'W');
   Begin
      kbdx_file_utils.close_file;
    EXCEPTION
      WHEN OTHERS THEN
        null;
   End;
   IF  ln_missing = 1 then
     lv_message := 'FAILED - NO_DATA_FOUND';
   ELSIF ln_missing = 2 then
     lv_message := 'FAILED - UTL_FILE.INVALID_PATH';
   ELSIF ln_missing = 3 then
     lv_message := 'FAILED - UTL_FILE.INVALID_MODE';
   ELSIF ln_missing = 4 then
     lv_message := 'FAILED - UTL_FILE.INVALID_FILEHANDLE';
   ELSIF ln_missing = 5 then
     lv_message := 'FAILED - UTL_FILE.INVALID_OPERATION';
   ELSIF ln_missing = 6 then
     lv_message := 'FAILED - UTL_FILE.READ_ERROR';
   ELSIF ln_missing = 7 then
     lv_message := 'FAILED - UTL_FILE.WRITE_ERROR';
   ELSIF ln_missing = 8 then
     lv_message := 'FAILED - UTL_FILE.INTERNAL_ERROR';
   ELSIF ln_missing > 0 then
     lv_message := 'FAILED - kbdx_file_utils returned '||ln_missing;
   END IF;
   If ln_missing = 0 then
     lv_message := 'PASSED - Filename TEST.FILE opened/closed successfully in &&LOBMANIP';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     dbms_output.put_line(' ');
   Else
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := '';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := 'WARNING - kbace.xkb_action_parameter ULT_FILE_DIR [LOBMANIP] points to &&LOBMANIP';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     if lv_parallel = 'YES' then
       lv_message := '          DETECTED Real Application Cluster (RAC). LOBMANIP filepath';
       dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
       lv_message := '          must be to a shared file system.';
       dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     end if;
     lv_message := '';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := '          This filepath stores the final output of the KBX Server; report files';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := '          with a dot kbx extension. Filepath must be valid, have read/write';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := '          permissions and space available. A KBX Server output file, written';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := '          to this filepath will exist until the fnd_concurrent_request that';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := '          generated the report, has been purged. On UNIX systems, the owner';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := '          of this filepath normally must be ORACLE. Remember that the owner of';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := '          files created by the UTL_FILE.FOPEN function is the owner of the';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := '          shadow process running the instance and is normally ORACLE.';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := '          Enter valid directory using $&&BASEPATH/utilities/kbdx_reset_all.sql';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := '          <<Tested using LOBMANIP - kbdx_file_utils.open_file>>';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
     lv_message := '';
     dbms_output.put_line(lv_message); begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_message);end;
   End If;
   For i in c_fail LOOP
     dbms_output.put_line(i.val2); 
   End Loop;
End;
/
