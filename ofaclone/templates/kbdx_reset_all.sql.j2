Declare
 lb_custom_found       boolean                                    := FALSE;
 ln_count              number                                     := 0; 
 ln_isxxkbx            number                                     := 0;
 lv_custom_security    xkb_action_parameters.parameter_value%type := NULL;
 lv_exec               varchar2(600);
 lv_value              xkb_action_parameters.parameter_value%type := NULL;
Begin
  Begin
    select NVL(parameter_value,'...null...') into lv_custom_security from xkb_action_parameters where parameter_name = 'CUSTOM_SECURITY';
    If lv_custom_security <> '...null...' THEN
      lb_custom_found := TRUE;
    End If;
   EXCEPTION
     WHEN OTHERS THEN
       lv_custom_security := NULL; lb_custom_found := FALSE;
  End;
  If lb_custom_found THEN
    Begin
      select parameter_value into lv_value from xkb_action_parameters
       where parameter_name = 'SSO_LOCAL_BOTH_LOGIN'
         and parameter_value in ('SSO','LOCAL','BOTH')
         and ROWNUM < 2;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','define isCustomSecurity = 1');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','define custom_security = '||lv_custom_security);end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','define sso_local_both_login = '||lv_value);end;
     Exception
       WHEN OTHERS THEN
         lv_custom_security := NULL; lb_custom_found := FALSE; --don't ask sso question
    End;
  End If;
  begin kbdx_kube_utilities.insert_test('kbdx_reset_all','define oracle_sid = {{ tgt_db }}');end;
  ln_isxxkbx := to_number(nvl(fnd_profile.value('KBACE_LICENSE_PLACEMENT'),'0'));
  begin kbdx_kube_utilities.insert_test('kbdx_reset_all','define isxxkbx = '||to_char(ln_isxxkbx));end;
  If ln_isxxkbx > 0 THEN --xxkbx schema support layer present and kbdx_users required
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','XXKBX Schema support SELECTED ['||to_char(ln_isxxkbx)||']');end;
    insert into xkb_action_parameters (parameter_name, parameter_value) values ('XXKBX_WRAPPER','?');
    select count(*) into ln_count from dba_objects  where object_name = 'KBDX_USERS'
       and ((object_type = 'TABLE' and owner = 'KBACE') or (object_type = 'SYNONYM' and owner = 'APPS'));
    If ln_count < 2  THEN --install table only if required and missing
      insert into xkb_action_parameters (parameter_name, parameter_value) values('KBDX_USERS','***FAILED*** KBDX_USERS TABLE MISSING ***FAILED***');
      commit;
        --collect all variables to keep input more consistent
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','define have_opw = 1');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','define apps_password = &&apps_password');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','define kbace_password = &&kbace_password');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','define custom_table_space = &&custom_table_space');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all',' prompt kbdx_reset_all - Connecting As KBACE');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','conn KBACE'||'/&&'||'kbace_password@&&'||'ORACLE_SID');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','set pagesize 55');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','set linesize 180');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','set serveroutput on FORMAT WRAP');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','set serveroutput on size 100000');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all',' prompt kbdx_reset_all - kbdx_users_t.sql');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','@kbdx_users_t.sql;');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all',' prompt kbdx_reset_all - Connecting As APPS');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','conn &&apps_account'||'/&&'||'apps_password@&&'||'ORACLE_SID');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','set pagesize 55');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','set linesize 180');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','set serveroutput on FORMAT WRAP');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','set serveroutput on size 100000');end;:question:
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','prompt kbdx_reset_all - kbdx_users_syn.sql');end;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all','@kbdx_users_syn.sql;');end;
    End If;
  Else
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all','define applsyspub_acct = 'applsyspub');end;
