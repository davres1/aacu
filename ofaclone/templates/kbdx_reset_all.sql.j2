Declare
 lb_grant_found        boolean        := false;
 ln_count              number         := 0;
 ln_isxxkbx            number                                     := 0;
 lv_exec               varchar2(600);
 lv_path               varchar2(4000);
Begin
  select parameter_value into lv_path from xkb_action_parameters where parameter_name = 'LOBMANIP';
  Begin
    lv_exec := 'drop directory lobmanip';
    execute immediate lv_exec;
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_exec);end;
   EXCEPTION
     WHEN OTHERS THEN
       begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','FAILED: '||lv_exec);end;
       NULL;
  End;
  Begin
    lv_exec := 'create directory lobmanip as '''||lv_path||'''';
    execute immediate lv_exec;
    begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_exec);end;
   EXCEPTION
     WHEN OTHERS THEN
       begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','FAILED: '||lv_exec);end;
       NULL;
  End;
    --
  If ln_isxxkbx > 0 THEN
    lb_grant_found := false;
    select count(*)
      into ln_count
      from DBA_TAB_PRIVS p
     where p.table_name = 'LOBMANIP'
       and p.grantee = 'XXKBX'
       and p.privilege = 'READ';
    If ln_count = 1 THEN
      lb_grant_found := true;
      begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','Found required "Grant READ on directory SYS.LOBMANIP to XXKBX"');end;
    Else --Required GRANT missing, attempt as APPS.
      Begin
        lv_exec := 'Grant READ on directory SYS.LOBMANIP to XXKBX';
        execute immediate lv_exec;
        begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary',lv_exec);end;
        lb_grant_found := true;
       EXCEPTION
         WHEN OTHERS THEN
           lb_grant_found := false;
           begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','FAILED: '||lv_exec);end;
           begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','ATTENTION: DBA must "Grant READ on directory SYS.LOBMANIP to XXKBX" as SYSTEM user.');end;
           dbms_output.put_line(' ');
           dbms_output.put_line('ATTENTION: DBA must "Grant READ on directory SYS.LOBMANIP to XXKBX" as SYSTEM user.');
      End;
    End If;
    If lb_grant_found THEN
      select count(*) into ln_count from dba_objects where object_name = 'KBDX_USERS' and object_type = 'TABLE' and owner = 'KBACE';
      If ln_count = 1 THEN
        delete from xkb_action_parameters where parameter_name in ('XXKBX_WRAPPER');
        insert into xkb_action_parameters (parameter_name, parameter_value) values ('XXKBX_WRAPPER',to_char(ln_isxxkbx));
        begin kbdx_kube_utilities.insert_test('kbdx_reset_all_summary','XXKBX Schema Support ACTIVE ['||to_char(ln_isxxkbx)||']');end;
      Else
        NULL; --leave in place recorded earlier values
      End If;
    End If;
    commit;
  End If;
End;
/
