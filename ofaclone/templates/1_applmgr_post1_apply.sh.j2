#set parameter_value = '{{ MAILER_PASSWORD }}'
#where parameter_id =
#( select parameter_id
#from fnd_svc_comp_params_tl
#where display_name = 'Password');
#commit;
#exit;
#EOF


echo "Running : If application witll not open…create these missing files"
cd {{ app_tgt_mount }}/{{ current_base }}/FMW_Home/webtier/instances/EBS_web_OHS1/diagnostics/logs
mkdir -p OPMN/opmn
touch {{ app_tgt_mount }}/{{ current_base }}/FMW_Home/webtier/instances/EBS_web_OHS1/diagnostics/logs/OPMN/opmn/opmn.out 
cd {{ app_tgt_mount }}/{{ current_base }}/FMW_Home/webtier/instances/EBS_web_OHS1/diagnostics/logs
mkdir -p OHS/EBS_web
touch {{ app_tgt_mount }}/{{ current_base }}/FMW_Home/webtier/instances/EBS_web_OHS1/diagnostics/logs/OHS/EBS_web/sec_audit_log

echo "Clearing Cache"
rm -rf $OA_HTML/cabo/images/cache/*
rm -rf $OA_HTML/cabo/styles/cache/*

echo "Increasing timeout to 900"
perl -p -i.bak -e 's/#WLIOTimeoutSecs 600/WLIOTimeoutSecs 900/g'  {{ app_tgt_mount }}/{{ current_base }}/FMW_Home/webtier/instances/EBS_web_OHS1/config/OHS/EBS_web/mod_wl_ohs.conf

echo "Changing shared filesystem"

perl -p -i.bak -e 's/s_shared_file_system.*?false/s_shared_file_system">true/' $CONTEXT_FILE