#! /bin/sh -x
#
# chkconfig: 2345 80 05
# description: start and stop Oracle Database Enterprise Edition on Oracle Linux 5 and 6
#

# In /etc/oratab, change the autostart field from N to Y for any
# databases that you want autostarted.
#
# Create this file as /etc/init.d/dbora and execute:
#  chmod 750 /etc/init.d/dbora
#  chkconfig --add dbora
#  chkconfig dbora on

# Note: Change the value of ORACLE_HOME to specify the correct Oracle home
# directory for your installation.
# ORACLE_HOME=/u01/app/oracle/product/11.1.0/db_1
ORACLE_HOME={{ tgt_oracle_home }}
listener= {{ src_cdb_name }}
#
# Note: Change the value of ORACLE to the login name of the oracle owner
ORACLE=oracle
. {{ tgt_oracle_home }}/{{ tgt_env }}_{{ tgt_db_node }}.env
PATH=${PATH}:$ORACLE_HOME/bin
HOST=`hostname`
PLATFORM=`uname`
export ORACLE_HOME PATH

case $1 in
'status')
        echo -n $"Oracle Process: "
        su $ORACLE -c "ps -ef | grep -E 'pmon|tnslsnr' | grep -v grep"
        ;;
'start')
        echo -n $"Starting Oracle: "
        su $ORACLE -c ". {{ tgt_oracle_home }}/{{ tgt_env }}_{{ tgt_db_node }}.env;$ORACLE_HOME/appsutil/scripts/{{ tgt_env }}_{{ tgt_db_node }}/addbctl.sh start" &
        su $ORACLE -c ". {{ tgt_oracle_home }}/{{ tgt_env }}_{{ tgt_db_node }}.env;$ORACLE_HOME/appsutil/scripts/{{ tgt_env }}_{{ tgt_db_node }}/addlnctl.sh start $listener" &
        ;;
'stop')
        echo -n $"Shutting down Oracle: "
        su $ORACLE -c ". {{ tgt_oracle_home }}/{{ tgt_env }}_{{ tgt_db_node }}.env;$ORACLE_HOME/appsutil/scripts/{{ tgt_env }}_{{ tgt_db_node }}/addbctl.sh stop" &
        su $ORACLE -c ". {{ tgt_oracle_home }}/{{ tgt_env }}_{{ tgt_db_node }}.env;$ORACLE_HOME/appsutil/scripts/{{ tgt_env }}_{{ tgt_db_node }}/addlnctl.sh stop $listener" &
        ;;
'restart')
        echo -n $"Shutting down Oracle: "
        su $ORACLE -c ". {{ tgt_oracle_home }}/{{ tgt_env }}_{{ tgt_db_node }}.env;$ORACLE_HOME/appsutil/scripts/{{ tgt_env }}_{{ tgt_db_node }}/addbctl.sh stop" &
        su $ORACLE -c ". {{ tgt_oracle_home }}/{{ tgt_env }}_{{ tgt_db_node }}.env;$ORACLE_HOME/appsutil/scripts/{{ tgt_env }}_{{ tgt_db_node }}/addlnctl.sh stop $listener" &
        sleep 90
        echo -n $"Starting Oracle: "
        su $ORACLE -c ". {{ tgt_oracle_home }}/{{ tgt_env }}_{{ tgt_db_node }}.env;$ORACLE_HOME/appsutil/scripts/{{ tgt_env }}_{{ tgt_db_node }}/addbctl.sh start" &
        su $ORACLE -c ". {{ tgt_oracle_home }}/{{ tgt_env }}_{{ tgt_db_node }}.env;$ORACLE_HOME/appsutil/scripts/{{ tgt_env }}_{{ tgt_db_node }}/addlnctl.sh start $listener" &
        ;;
*)
        echo "usage: $0 {start|stop|restart}"
        exit
        ;;
esac

exit