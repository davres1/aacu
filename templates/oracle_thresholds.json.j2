        "type": "mermaid",
        "definition": "graph TB\n  Scan((SCAN Listener))\n  L1[Local LSNR Node1]\n  L2[Local LSNR Node2]\n  Inst1[(Instance 1)]\n  Inst2[(Instance 2)]\n  ASM[(+DATA / +RECO ASM)]\n  Scan --> L1\n  Scan --> L2\n  L1 --> Inst1\n  L2 --> Inst2\n  Inst1 -. interconnect .- Inst2\n  Inst1 --> ASM\n  Inst2 --> ASM"
      },
      {
        "id":   "rman_strategy",
        "title":"RMAN Backup Strategy (rolling 24h)",
        "type": "mermaid",
        "definition": "gantt\n    title Daily RMAN Schedule\n    dateFormat HH:mm\n    axisFormat %H:%M\n    section Level 0 (Full)\n    Sunday weekly :a1, 22:00, 240m\n    section Level 1 (Incremental)\n    Mon-Sat nightly :22:00, 90m\n    section Archivelog\n    Every 15 minutes :crit, 00:00, 24h\n    section RMAN crosscheck\n    Daily housekeeping :04:00, 30m"
      },
      {
        "id":   "cis_workflow",
        "title":"CIS Oracle 19c Audit & Remediation",
        "type": "mermaid",
        "definition": "flowchart TD\n  A[Run CIS Oracle 19c checks] --> B{Findings}\n  B -->|All Pass| Z[Green - report to dashboard]\n  B -->|Fail| C[Capture BEFORE state]\n  C --> D[Append revert to rollback.sql]\n  D --> E{Approve?}\n  E -->|Audit only| F[Stop here]\n  E -->|Dry run| G[Log fix + revert]\n  E -->|Apply| H[Run ALTER SYSTEM / sqlplus fix]\n  H --> I[Log AFTER state]\n  I --> J[Push score to InfluxDB]\n  J --> Z\n  G --> K[Review rollback.sql with CAB]\n  K --> E"
      },
      {
        "id":   "alert_pipeline",
