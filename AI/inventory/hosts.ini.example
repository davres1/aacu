; /etc/ansible/hosts (or AI/inventory/hosts.ini)
;
; The unified chatbot under AI/ serves both SQL Server and Oracle. The
; UI tabs switch which group + databases.ini drive the dropdown:
;
;   [sql_servers]      ← SQL Server tab
;   [oracle_servers]   ← Oracle tab
;
; Either group can be empty; the tab will just show "no hosts in [group]".

[sql_servers]
sqlprod01.example.com
sqlprod02.example.com

[sql_servers:vars]
ansible_connection=winrm
ansible_user=svc_ansible
ansible_password=CHANGE_ME
ansible_winrm_transport=ntlm
ansible_winrm_server_cert_validation=ignore
ansible_port=5985


[oracle_servers]
cor089xx1
cor089123

[oracle_servers:vars]
ansible_connection=ssh
ansible_user=ansible
; SSH keys typically used; ansible-vault for any password
